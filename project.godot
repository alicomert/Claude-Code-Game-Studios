;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sector 9 — Mechanics Lab"
run/main_scene="res://src/lab/mechanics_lab.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

